{
  "name": "fairy",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"nest start --watch\" \"vite --config vite.config.mts\"",
    "build": "nest build && vite build --config vite.config.mts",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "e2e": "playwright test",
    "db:migrate": "dbmate --env DATABASE_OWNER_URL --migrations-dir db/migrations --no-dump-schema --wait up --strict",
    "db:pull": "scripts/db-pull.sh",
    "db:seed": "tsx scripts/seed-demo.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@tanstack/react-query": "^5.108.4",
    "drizzle-orm": "^0.45.4",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@playwright/test": "^1.65.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dbmate": "^2.38.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}

# Copy to .env for local development. Fake values only: never put a real secret here.
APP_ENV=local
PORT=3000
PUBLIC_URL=http://localhost:5173

# The app connects as fairy_app; migrations and the seed connect as the owner.
DATABASE_URL=postgres://fairy_app:fairy_app_local@localhost:5432/fairy?sslmode=disable
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/fairy?sslmode=disable

# The hello-world reads this tenant's greeting (removed by the Tenant slice).
DEMO_TENANT_ID=01937b2e-0000-7000-8000-000000000001
